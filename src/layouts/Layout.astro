---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Home",
  description = "Renny Harlin writes about artificial intelligence, computer science, robotics, and life.",
} = Astro.props;
const pageTitle = title === "Home" ? "Renny Harlin" : `${title} | Renny Harlin`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
		<script is:inline>
			(() => {
				let savedTheme;
				try {
					savedTheme = localStorage.getItem("renny-theme");
				} catch {
					// Use the system preference when storage is unavailable.
				}
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle(
					"dark",
					savedTheme === "dark" || (!savedTheme && prefersDark),
				);
			})();
		</script>
	</head>
	<body class="flex min-h-dvh flex-col antialiased">
		<Navbar />
		<main class="mx-auto w-full max-w-2xl flex-1 px-5 pb-16 pt-10 sm:px-6 sm:pt-14">
			<slot />
		</main>
		<Footer />
	</body>
</html>
