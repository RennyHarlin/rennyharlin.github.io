---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatPostDate, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <article>
    <a href="/" class="mb-8 inline-flex items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-primary">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      All posts
    </a>
    <header class="mb-10">
      <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{post.data.title}</h1>
      {post.data.description && <p class="mt-4 text-base leading-7 text-muted-foreground">{post.data.description}</p>}
      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground">
        <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
        {post.data.topics?.map((topic) => <a href={`/topics/#${encodeURIComponent(topic)}`} class="underline decoration-border underline-offset-4 hover:text-primary hover:decoration-current">#{topic}</a>)}
      </div>
    </header>
    <div class="prose prose-neutral dark:prose-invert max-w-none prose-headings:font-sans prose-headings:tracking-tight prose-p:leading-8 prose-a:text-primary prose-a:decoration-primary/40 hover:prose-a:decoration-primary prose-pre:overflow-x-auto prose-img:rounded-lg">
      <Content />
    </div>
  </article>
</Layout>
