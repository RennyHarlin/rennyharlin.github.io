---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../posts';

const posts = await getPosts();
const years = Map.groupBy(posts, (p) => p.data.date.getFullYear());
---

<Base title="Posts" description="All posts, newest first.">
  <h1 class="py-8 text-3xl font-bold text-zinc-900 dark:text-zinc-100">Posts</h1>
  {
    [...years].map(([year, posts]) => (
      <section class="mb-10">
        <h2 class="mb-6 text-sm font-semibold text-zinc-500">{year}</h2>
        <PostList posts={posts} />
      </section>
    ))
  }
</Base>
