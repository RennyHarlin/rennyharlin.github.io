---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingTime, slugify, type Post } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, date, updated, topics } = post.data;
---

<Base title={title} description={description ?? `${title}, by Renny Harlin.`} article={{ date, updated, topics }}>
  <article>
    <header class="py-8">
      <h1 class="text-3xl leading-tight font-bold text-zinc-900 dark:text-zinc-100">{title}</h1>
      <p class="mt-3 text-sm text-zinc-500">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <>{' · updated '}<time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        {` · ${readingTime(post.body)}`}
      </p>
      {
        topics.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2 text-xs">
            {topics.map((t) => (
              <li>
                <a
                  href={`/topics/${slugify(t)}/`}
                  class="rounded-full border border-zinc-300 px-2.5 py-0.5 hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500"
                >
                  {t}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose max-w-none prose-zinc dark:prose-invert prose-headings:scroll-mt-8 prose-a:underline-offset-4">
      <Content />
    </div>
  </article>
</Base>
