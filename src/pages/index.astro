---
import Layout from "../layouts/Layout.astro";
import { formatPostDate, getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
---

<Layout description="Renny Harlin writes about artificial intelligence, computer science, robotics, and life.">
  <header class="mb-12 sm:mb-14">
    <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">Hi there, I’m Renny Harlin.</h1>
    <p class="mt-5 text-base leading-7 text-muted-foreground">
      I write about artificial intelligence, computer science, and robotics. Sometimes I write about life, too.
    </p>
  </header>

  <section aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="mb-2 text-sm font-semibold uppercase tracking-wide text-muted-foreground">Posts</h2>
    {posts.length > 0 ? (
      <ol class="divide-y divide-border/70">
        {posts.map((post) => (
          <li class="py-6 first:pt-4">
            <article>
              <h3 class="text-xl font-semibold leading-snug tracking-tight sm:text-2xl">
                <a href={`/blogs/${post.id}/`} class="underline decoration-transparent underline-offset-4 transition-colors hover:text-primary hover:decoration-current focus-visible:decoration-current">{post.data.title}</a>
              </h3>
              <time datetime={post.data.date.toISOString()} class="mt-2 block text-sm text-muted-foreground">{formatPostDate(post.data.date)}</time>
              {post.data.description && <p class="mt-3 text-sm leading-7 text-muted-foreground sm:text-base">{post.data.description}</p>}
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="py-6 text-muted-foreground">No posts yet.</p>
    )}
  </section>
</Layout>
