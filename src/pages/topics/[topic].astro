---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { TOPIC_DESCRIPTIONS } from '../../site';
import { getPosts, groupByTopic, slugify, type Post } from '../../posts';

export async function getStaticPaths() {
  return groupByTopic(await getPosts()).map(([name, posts]) => ({
    params: { topic: slugify(name) },
    props: { name, posts },
  }));
}

const { name, posts } = Astro.props as { name: string; posts: Post[] };
const blurb = TOPIC_DESCRIPTIONS[name];
---

<Base title={name} description={blurb ?? `Posts about ${name}.`}>
  <header class="py-8">
    <p class="text-sm text-zinc-500"><a href="/topics/" class="hover:underline">Topics</a> /</p>
    <h1 class="mt-1 text-3xl font-bold text-zinc-900 dark:text-zinc-100">{name}</h1>
    {blurb && <p class="mt-4 leading-relaxed">{blurb}</p>}
  </header>
  <PostList posts={posts} />
</Base>
