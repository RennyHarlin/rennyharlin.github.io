---
import { formatDate, type Post } from '../posts';

const { posts } = Astro.props as { posts: Post[] };
---

<ul class="space-y-6">
  {
    posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`} class="group block">
          <h3 class="font-medium text-zinc-900 group-hover:underline dark:text-zinc-100">
            {post.data.title}
            {post.data.draft && <span class="ml-2 text-xs text-amber-600">draft</span>}
          </h3>
          {post.data.description && <p class="mt-1 text-sm">{post.data.description}</p>}
          <time datetime={post.data.date.toISOString()} class="mt-1 block text-sm text-zinc-500">
            {formatDate(post.data.date)}
          </time>
        </a>
      </li>
    ))
  }
</ul>
