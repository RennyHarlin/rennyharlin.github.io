---
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/topics/", label: "Topics", active: path.startsWith("/topics") },
  { href: "/about/", label: "About", active: path.startsWith("/about") },
];
---

<header class="border-b border-border/70">
  <div class="mx-auto grid max-w-2xl grid-cols-[minmax(0,1fr)_auto] items-center gap-y-2 px-5 py-4 sm:flex sm:gap-6 sm:px-6">
    <a href="/" aria-current={path === "/" ? "page" : undefined} class="font-semibold tracking-tight hover:text-primary" aria-label="Renny Harlin, home">
      Renny Harlin
    </a>
    <nav aria-label="Main navigation" class="col-span-2 row-start-2 flex items-center gap-5 text-sm sm:ml-auto">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.active ? "page" : undefined}
          class:list={[
            "py-1 underline-offset-4 hover:text-primary hover:underline",
            link.active ? "font-semibold text-foreground" : "text-muted-foreground",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="col-start-2 row-start-1">
      <ThemeToggle />
    </div>
  </div>
</header>
